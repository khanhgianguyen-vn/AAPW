# ── nixus-labs integration ──
# Base URL of the nixus-labs website (no trailing slash)
NIXUS_API_URL=https://nixuslabs.com

# Shared secret between AAPW and nixus-labs — must match AAPW_API_KEY in nixus-labs .env
AAPW_API_KEY=change-me-to-a-random-secret

# ── Captcha solving ──
# Get your key at 2captcha.com
TWOCAPTCHA_API_KEY=5737b5f6cb208cdd1f478afe385cd812

# ── Polling ──
# How often AAPW checks for broken accounts (minutes, default: 30)
POLL_INTERVAL_MINUTES=5

# ── Browser options ──
USE_PROXY=false
HEADLESS=false
